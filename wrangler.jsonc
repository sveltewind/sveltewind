{
	"name": "sveltewind",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	}
}
